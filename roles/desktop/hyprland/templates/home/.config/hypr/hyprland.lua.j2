-- Hyprland configuration (Lua format, requires Hyprland >= 0.55)

require("env")
require("keybindings")

-- AUTOSTART

hl.on("hyprland.start", function()
    for _, cmd in ipairs({
        "kanshi",
        "~/.config/hypr/scripts/power-monitor.sh",
        "hyprsunset",
        "waybar",
        "swaync",
        "vicinae server",
        "/usr/local/bin/xdph-launcher.sh",
        "configure-handlr",
        "syncthing",
        "lxpolkit",
        "voxtype daemon",
    }) do
        hl.dispatch(hl.dsp.exec_cmd(cmd))
    end
end)

