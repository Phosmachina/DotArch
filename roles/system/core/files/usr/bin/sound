#!/bin/sh

case $2 in
    ''|*[!0-9]*) num=5 ;;
    *)           num=$2 ;;
esac

usage() {
    echo "Usage: ${0##*/} up|down [NUM]"
    echo "       ${0##*/} notify|volume"
}

# if [ -f "$XDG_RUNTIME_DIR/pulse/pid" ]; then
    up() { pulsemixer --change-volume +"$num"; }
    down() { pulsemixer --change-volume -"$num"; }
    volume() { pulsemixer --get-volume | cut -d' ' -f1; }
#  else
#      up() { amixer sset Master $num%+; }
#      down() { amixer sset Master $num%-; }
#      volume() { amixer | grep "Mono: Playback .* \[on\]$" | cut -d' ' -f6; }
#  fi

notify() {
	# Replacement per the Notifications spec: -p prints the daemon-assigned
	# id, -r replaces that notification next call. The id must persist across
	# keypresses, so keep it in a runtime file. Invented fixed ids (the old
	# dunstify -r 9991049 pattern) are ignored by swaync and stack instead.
	id_file="${XDG_RUNTIME_DIR:-/tmp}/sound-notify-id"
	id=$(cat "$id_file" 2>/dev/null)
	if [ -n "$id" ]; then
		notify-send -p -r "$id" -t 1200 "volume" "volume: $(volume)" >"$id_file" 2>/dev/null
	else
		notify-send -p -t 1200 "volume" "volume: $(volume)" >"$id_file" 2>/dev/null
	fi
}

case $1 in
    up)     up ;;
    down)   down ;;
    notify) notify ;;
    volume) volume ;;
    *)      usage; exit 1 ;;
esac
