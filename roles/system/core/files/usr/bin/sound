#!/bin/sh

case $2 in
    ''|*[!0-9]*) num=5 ;;
    *)           num=$2 ;;
esac

usage() {
    echo "Usage: ${0##*/} up|down [NUM]"
    echo "       ${0##*/} notify|volume"
}

# if [ -f "$XDG_RUNTIME_DIR/pulse/pid" ]; then
    up() { pulsemixer --change-volume +$num; }
    down() { pulsemixer --change-volume -$num; }
    volume() { pulsemixer --get-volume | cut -d' ' -f1; }
#  else
#      up() { amixer sset Master $num%+; }
#      down() { amixer sset Master $num%-; }
#      volume() { amixer | grep "Mono: Playback .* \[on\]$" | cut -d' ' -f6; }
#  fi

notify() {
	# swaync (the notification daemon) ignores dunst's replaces-id, so
	# replace manually: close the previous toast, then show a short-lived one.
	swaync-client --close-latest >/dev/null 2>&1
	dunstify "volume" "volume: $(volume)" -t 1200
}

case $1 in
    up)     up ;;
    down)   down ;;
    notify) notify ;;
    volume) volume ;;
    *)      usage; exit 1 ;;
esac
