#!/bin/bash
#
# transcript - push-to-talk dictation and file transcription via DeepInfra.
#
# Usage:
#   transcript [--clean light|full|raw]        toggle dictation recording
#   transcript FILE [--srt]                    transcribe an audio/video file
#
# Dictation pipeline: arecord -> sox silence removal -> ffmpeg AAC ->
# whisper (curl) -> optional LLM cleanup -> wl-copy + ctrl+shift+v paste.

set -uo pipefail

dependencies=("arecord" "curl" "jq" "wl-copy" "wtype" "sox" "ffmpeg")

inference_model="openai/whisper-large-v3-turbo"
llm_model="deepseek-ai/DeepSeek-V4-Flash-0731"
api_base="https://api.deepinfra.com"

# Silence-removal threshold: must sit ABOVE the mic's noise floor and BELOW
# speech. Measured on this host's Blue Snowball 2026-08-20 (input at 100%):
# ambient max 3.9% / RMS 0.9%, real speech sustained ~1-1.5% (peak 7.9%) —
# a narrow window. 0.7%/0.1s keeps 93% of a real speech sample while cutting
# 2s pauses; higher values (1.5%+) cut speech, 0.1% (the old value) matched
# only digital silence. Re-measure if the mic or room changes.
silence_threshold="0.6%"

state_file="${XDG_RUNTIME_DIR:-/tmp}/transcript.state"
last_raw_file="${XDG_RUNTIME_DIR:-/tmp}/transcript-last-raw.txt"
last_out_file="${XDG_RUNTIME_DIR:-/tmp}/transcript-last.txt"
token_file="$HOME/.config/transcript/token"
recording_info="/tmp/recording_info"

auth_token=""
clean_level="full"
srt_flag=0
input_file=""
temp_files=()

usage() {
    cat <<'EOF'
transcript - dictation and file transcription via DeepInfra

Usage:
  transcript [--clean light|full|raw]     toggle push-to-talk dictation
  transcript FILE [--srt]                 write FILE.txt (and FILE.srt)

Options:
  --clean light   fix punctuation/misrecognitions, remove artifacts
  --clean full    light + reformat into paragraphs/lists (default)
  --clean raw     skip the LLM pass (shorthand: --raw)
  --srt           with FILE: also write subtitles
  -h, --help      show this help

The last dictation's raw whisper text and final text are kept in
$XDG_RUNTIME_DIR/transcript-last-raw.txt and transcript-last.txt for
comparison.
EOF
}

set_state() {
    printf '%s' "$1" > "$state_file"
}

# No notifications by design: the waybar pill shows the dictation state
# (recording / transcribing / cleaning / error) and volume lives in the status bar.
mark_error() {
    set_state error
}

register_temp() {
    temp_files+=("$1")
}

cleanup_temps() {
    local f
    for f in "${temp_files[@]}"; do
        [[ -f "$f" ]] && rm -f "$f"
    done
}

check_dependencies() {
    local dependency
    for dependency in "${dependencies[@]}"; do
        if ! command -v "$dependency" &>/dev/null; then
            echo "Error: '$dependency' command not found. Please install the corresponding package." >&2
            exit 1
        fi
    done
}

load_token() {
    if [[ -n "${DEEPINFRA_API_TOKEN:-}" ]]; then
        printf '%s' "$DEEPINFRA_API_TOKEN"
    elif [[ -r "$token_file" ]]; then
        head -n 1 "$token_file" | tr -d '[:space:]'
    else
        return 1
    fi
}

api_call() {
    # api_call DESCRIPTION CURL_ARGS...
    # Performs the HTTP request; retries on transport failure or HTTP >= 400
    # (3 attempts, 2s/4s backoff). Prints the response body on 2xx.
    local description="$1"
    shift
    local attempt response http_code
    for attempt in 1 2 3; do
        response=$(curl -sS --max-time 120 -w $'\n%{http_code}' "$@" 2>/dev/null) || response=""
        http_code="${response##*$'\n'}"
        if [[ "$http_code" =~ ^2 ]]; then
            printf '%s' "${response%$'\n'*}"
            return 0
        fi
        [[ "$attempt" -lt 3 ]] && sleep $((attempt * 2))
    done
    echo "Error: API call failed after 3 attempts ($description, status: ${http_code:-no response})" >&2
    return 1
}

start_recording() {
    set_state recording
    # Sweep wavs orphaned by crashed sessions; /tmp/recording_info is the
    # single-recording lock, so no live recording can match here.
    rm -f /tmp/recording_*.wav
    local tempfile record_pid
    tempfile=$(mktemp /tmp/recording_XXXXXX.wav)
    arecord -f cd "$tempfile" >/dev/null 2>&1 &
    record_pid=$!
    echo "$record_pid $tempfile" > "$recording_info"
}

stop_recording() {
    local record_pid tempfile
    read -r record_pid tempfile < "$recording_info"
    register_temp "$tempfile"

    kill -INT "$record_pid" 2>/dev/null || kill "$record_pid" 2>/dev/null || true
    sleep 0.3
    set_state transcribing

    local processed_audio text
    if ! processed_audio=$(prepare_audio "$tempfile"); then
        rm -f "$recording_info"
        set_state idle
        return 0
    fi
    # prepare_audio ran inside $(...): its register_temp calls were lost to a
    # subshell, so register the returned AAC path here for the EXIT trap.
    register_temp "$processed_audio"

    if ! text=$(transcribe_audio "$processed_audio" | format_txt); then
        mark_error
        rm -f "$recording_info"
        return 1
    fi
    if ! has_speech "$text"; then
        rm -f "$recording_info"
        set_state idle
        return 0
    fi

    if [[ "$clean_level" != "raw" ]]; then
        printf '%s' "$text" > "$last_raw_file"
        set_state cleaning
        text=$(printf '%s' "$text" | llm_clean "$clean_level")
    else
        printf '%s' "$text" > "$last_raw_file"
    fi
    printf '%s' "$text" > "$last_out_file"

    # Paste instead of typing: instant regardless of length, and pasted
    # newlines do not submit chat messages the way typed Returns do.
    # ctrl+shift+v also pastes in terminals, where ctrl+v is quoted-insert.
    printf '%s' "$text" | wl-copy || true
    sleep 0.2 # wl-copy takes the selection asynchronously; give it a beat
    wtype -M ctrl -M shift -k v -m shift -m ctrl || true

    rm -f "$recording_info"
    set_state idle
}

# Silence-removes the recording and returns the AAC path ready for upload.
prepare_audio() {
    local tempfile="$1"
    local trimmed_audio
    trimmed_audio=$(mktemp /tmp/trimmed_XXXXXX.wav)
    register_temp "$trimmed_audio"

    sox "$tempfile" "$trimmed_audio" silence 1 0.1 "$silence_threshold" -1 0.1 "$silence_threshold" 2>/dev/null || true

    # Less than ~0.25s of audio left (CD wav = 176400 bytes/s) means no speech.
    if [[ ! -s "$trimmed_audio" ]] || [[ "$(stat -c%s "$trimmed_audio")" -lt 44100 ]]; then
        rm -f "$trimmed_audio"
        return 1
    fi

    # The trimmed wav is an intermediate: remove it here because this whole
    # function runs inside a command substitution whose register_temp calls
    # cannot reach the EXIT trap in the parent shell.
    local aac_file
    if ! aac_file=$(convert_to_aac "$trimmed_audio"); then
        rm -f "$trimmed_audio"
        return 1
    fi
    rm -f "$trimmed_audio"
    printf '%s\n' "$aac_file"
}

# Processes an audio/video file: writes <name>.txt (and <name>.srt).
process_file() {
    local path="${1%.*}"
    local audio_file json_result
    audio_file=$(convert_to_aac "$1") || exit 1
    # convert_to_aac ran inside $(...): register the path in this shell so
    # the EXIT trap removes it.
    register_temp "$audio_file"
    if ! json_result=$(transcribe_audio "$audio_file"); then
        echo "Error: transcription failed for '$1'" >&2
        exit 1
    fi
    printf '%s' "$json_result" | format_txt > "${path}.txt"
    if [[ "$srt_flag" -eq 1 ]]; then
        printf '%s' "$json_result" | format_srt > "${path}.srt"
    fi
    return 0
}

convert_to_aac() {
    local tmp_audio
    tmp_audio=$(mktemp /tmp/"$(basename "$1" .wav)"_XXXXXX.aac)
    register_temp "$tmp_audio"
    ffmpeg -y -i "$1" -vn -c:a aac -ar 44100 -ac 2 "$tmp_audio" >/dev/null 2>&1 || {
        echo "Error: Unable to convert file to AAC format." >&2
        rm -f "$tmp_audio"
        return 1
    }
    printf '%s\n' "$tmp_audio"
}

# Transcribes an AAC file with whisper via the DeepInfra inference API.
transcribe_audio() {
    api_call "whisper inference" \
        -X POST \
        -H "Authorization: Bearer ${auth_token}" \
        -F "audio=@$1" \
        "${api_base}/v1/inference/${inference_model}"
}

# llm_clean LEVEL - cleans the transcript from stdin, prints cleaned text.
# Dictation must never hard-fail on the optional stage: falls back to input.
llm_clean() {
    local level="$1"
    local input prompt response cleaned
    input=$(cat)
    [[ -z "${input//[[:space:]]/}" ]] && { printf '%s' "$input"; return 0; }

    case "$level" in
        light)
            prompt='You are a post-processor for speech-to-text output. Respond with ONLY the corrected text itself: no preamble, no quotes, no explanations. Correct misrecognized words and punctuation and remove phantom filler artifacts. Speech recognizers often hallucinate a trailing standalone acknowledgement ("Merci", "Thank you", "Thanks") after the final silence — always remove such trailing acknowledgements, and never add pleasantries of your own. Keep the wording and language exactly as spoken. Do not summarize, translate, or reformat.'
            ;;
        full)
            prompt='You are a post-processor for speech-to-text output from someone who thinks aloud. Respond with ONLY the cleaned text itself: no preamble, no quotes, no explanations. Clean it the way Google Recorder does: remove fillers and hesitations (um, uh, euh, stutters, "you know", "like"), drop abandoned phrasing when the speaker self-corrects or restarts a sentence, and collapse repeated statements of the same idea. Organize the result into paragraphs, using bullet lists for enumerations. Correct misrecognized words and punctuation. Speech recognizers often hallucinate a trailing standalone acknowledgement ("Merci", "Thank you", "Thanks") after the final silence — always remove such trailing acknowledgements, and never add pleasantries of your own. Keep the spoken language. Do not summarize, shorten, translate, or add information.'
            ;;
    esac

    # chat_template_kwargs disables Qwen3.5 thinking mode — otherwise the
    # answer lands in reasoning_content and .content comes back empty.
    if ! response=$(api_call "llm cleanup" \
        -X POST \
        -H "Authorization: Bearer ${auth_token}" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg model "$llm_model" --arg prompt "$prompt" --arg text "$input" \
            '{model: $model, temperature: 0, max_tokens: 2048,
              chat_template_kwargs: {enable_thinking: false},
              messages: [{role: "system", content: $prompt},
                         {role: "user", content: $text}]}')" \
        "${api_base}/v1/openai/chat/completions"); then
        printf '%s' "$input"
        return 0
    fi

    if ! cleaned=$(printf '%s' "$response" | jq -er '.choices[0].message.content // empty' 2>/dev/null) || [[ -z "$cleaned" ]]; then
        cleaned="$input"
    fi
    printf '%s' "$cleaned"
}

# Whisper returns 200 with empty or punctuation-only text when nothing
# survived silence removal — that is not an error.
has_speech() {
    [[ -n "${1//[[:space:][:punct:]]/}" ]]
}

# Format transcribed text for plain text output
format_txt() {
    jq -r '.text | gsub("^ +";"")'
}

# Format transcribed text into SRT subtitle format
format_srt() {
    jq -r '
.segments[] |
   .start as $start |
    ($start | tostring | split(".")) as $split |
    (
        ($split[0] | tonumber | strftime("%H:%M:%S")) +
        "." +
        ($split[1] |.[0:3])
    ) as $start_formatted |
   .end as $end |
    ($end | tostring | split(".")) as $split |
    (
        ($split[0] | tonumber | strftime("%H:%M:%S")) +
        "." +
        ($split[1] |.[0:3])
    ) as $end_formatted |
   "\(.id)\n\($start_formatted) --> \($end_formatted)\n\(.text | gsub("^ +";"") | gsub(" +$";""))\n"
  '
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clean)
                [[ $# -ge 2 ]] || { echo "Error: --clean requires a value (light|full|raw)" >&2; exit 1; }
                clean_level="$2"
                shift 2
                ;;
            --clean=*)
                clean_level="${1#*=}"
                shift
                ;;
            --raw)
                clean_level="raw"
                shift
                ;;
            --srt)
                srt_flag=1
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            *)
                if [[ -n "$input_file" ]]; then
                    echo "Error: unexpected argument '$1'" >&2
                    exit 1
                fi
                input_file="$1"
                shift
                ;;
        esac
    done
    if [[ ! "$clean_level" =~ ^(light|full|raw)$ ]]; then
        echo "Error: --clean must be light, full, or raw" >&2
        exit 1
    fi
}

# Main script logic: starts/stops recording or processes a file
main() {
    parse_args "$@"
    check_dependencies

    if ! auth_token=$(load_token); then
        echo "Error: no API token found (set DEEPINFRA_API_TOKEN or create $token_file)" >&2
        mark_error
        exit 1
    fi

    if [[ -z "$auth_token" ]]; then
        echo "Error: API token is empty (check $token_file or \$DEEPINFRA_API_TOKEN)" >&2
        mark_error
        exit 1
    fi

    if [[ -n "$input_file" ]]; then
        process_file "$input_file"
        return
    fi

    if [[ -f "$recording_info" ]]; then
        local record_pid _
        read -r record_pid _ < "$recording_info"
        if ps -p "$record_pid" >/dev/null; then
            stop_recording
        else
            start_recording
        fi
    else
        start_recording
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    trap cleanup_temps EXIT
    trap 'cleanup_temps; exit 130' INT TERM
    main "$@"
fi
