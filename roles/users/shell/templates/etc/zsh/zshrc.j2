# Global Zsh Configuration for DotArch

# Path to your oh-my-zsh installation.
export ZSH=/usr/share/oh-my-zsh

# Theme
ZSH_THEME="arrow"

# Options
DISABLE_AUTO_TITLE="false"
ENABLE_CORRECTION="true"
CORRECT_IGNORE="[_|.]*"
COMPLETION_WAITING_DOTS="true"

# Plugins
plugins=(
    git
    fzf
    aliases
    compleat
    command-not-found
    cp
    history
    zoxide
    jump
    systemd
    archlinux
    zsh-interactive-cd
)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Load zsh-autosuggestions.
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-autopair/autopair.zsh 2>/dev/null

# Load zsh-syntax-highlighting; should be last.
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null

# Readable shell comments: plugin default is fg=black (color0, invisible on Dark_Pastel);
# fg=8 is bright black, brightened to #8f8f8f in kitty's Dark_Pastel.conf
ZSH_HIGHLIGHT_STYLES[comment]='fg=8'

# Word characters
WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'
MOTION_WORDCHARS='~!#$%^&*(){}[]<>?.+;-/'
autoload -U select-word-style
select-word-style normal

# History in cache directory
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/history
setopt histsavenodups histignorespace appendhistory autocd beep notify promptsubst completealiases

# Keybindings
bindkey '^H' backward-delete-word       # ctrl + backspace
bindkey '^[[3;5~' delete-word           # ctrl + del
bindkey '^[[1;5D' backward-word         # ctrl + left
bindkey '^[[1;5C' forward-word          # ctrl + right
bindkey '^[[5~' beginning-of-history    # pgup
bindkey '^[[6~' end-of-history          # pgdn
bindkey '^[[H' beginning-of-line        # home
bindkey '^[[F' end-of-line              # end
bindkey '^?' backward-delete-char       # backspace
bindkey '^[[3~' delete-char             # del
bindkey '^U' backward-kill-line         # ctrl + u
bindkey '^K' kill-line                  # ctrl + k
bindkey -s '^o' 'y\n'
bindkey -s '^n' 'newterm\n'

newterm() {
	setsid -f wezterm start --always-new-process
}

# ==============================================================================
# Custom Aliases & Functions (Overrides)
# ==============================================================================

# Load DotArch global configuration last to ensure it overrides plugins
[ -f /etc/profile.d/dotarch.sh ] && source /etc/profile.d/dotarch.sh
